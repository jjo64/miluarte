# ==========================================
# 🌿 MILUARTE CMS — Variables de Entorno
# ==========================================
# Copia este archivo como .env.local en la raíz del proyecto para tus claves locales.

# 1. Cloudinary (Tu cuenta: doznr2qm4)
# Consíguelas en https://console.cloudinary.com/ -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=doznr2qm4
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 2. Vercel KV / Upstash Redis (Base de datos en la nube)
# Consíguelas en Vercel Dashboard -> Storage -> KV Database
# En desarrollo local funciona automáticamente con almacenamiento local sin necesidad de rellenar esto.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3. Autenticación del Panel Admin
ADMIN_EMAIL=miluartedenara@gmail.com
JWT_SECRET=miluarte_secret_jwt_key_2026

# 4. Correo Resend (Para formulario de contacto y encargos)
# Obtén tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente verificado en Resend (subdominio contact.miluartedenara.com)
RESEND_FROM=Miluarte <contacto@contact.miluartedenara.com>
# Correos de destino donde recibirás los mensajes y encargos
RESEND_TO_PRIORITY=miluartedenara@gmail.com
RESEND_TO_COMMON=miluartedenara@gmail.com

# 5. Notificaciones de Telegram (Bot de Nerea)
# BotFather Token (ej: 7123456789:AAFxxx...)
TELEGRAM_BOT_TOKEN=
# Chat ID de Nerea (obtenido con https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=

# 6. Web Push (PWA - Notificaciones nativas a medio plazo)
# Generar claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 7. Cloudflare R2 (Almacenamiento de Modelos 3D y Videos)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=miluarte-media
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
CLOUDFLARE_R2_ENDPOINT=https://xxxxxx.r2.cloudflarestorage.com
ADMIN_IP_WHITELIST=

